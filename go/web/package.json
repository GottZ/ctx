{
  "name": "ctx-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MPL-2.0",
  "//": "graph stack is sigma+graphology by decision (F5-W2). Never add @cosmograph/cosmograph: CC-BY-NC license is incompatible with this MPL-2.0 project.",
  "scripts": {
    "dev": "vite",
    "tokens": "node tokens/generate.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "lint:css": "stylelint \"src/**/*.{css,svelte}\" && node lint/inline-gate.mjs",
    "check": "bun run lint:css && svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:budget": "bun e2e/perf/chunk-budget.ts",
    "perf:lhci": "lhci autorun --config=lighthouserc.cjs",
    "test:e2e": "playwright test",
    "e2e:visual": "bash e2e-visual.sh",
    "e2e:matrix": "bun e2e/contract/coverage.ts",
    "e2e:live": "bash e2e/live/run-live.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.61.1",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tsconfig/svelte": "5.0.8",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.4.1",
    "@types/three": "0.185.4",
    "dompurify": "3.4.14",
    "eventsource-parser": "3.1.0",
    "graphology": "0.26.0",
    "graphology-layout-forceatlas2": "0.10.1",
    "jsdom": "29.1.1",
    "markdown-it": "14.3.0",
    "postcss-html": "1.8.1",
    "sigma": "3.0.3",
    "stylelint": "17.14.0",
    "stylelint-config-html": "1.1.0",
    "stylelint-declaration-strict-value": "1.11.1",
    "sv-router": "0.18.0",
    "svelte": "5.56.4",
    "svelte-check": "4.7.2",
    "typescript": "6.0.3",
    "vite": "8.1.4",
    "vite-plugin-compression2": "2.5.3",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "2.0.1",
    "@cosmos.gl/graph": "3.4.1",
    "@deck.gl/core": "9.3.11",
    "@deck.gl/layers": "9.3.11",
    "@sigma/edge-curve": "^3.1.0",
    "three": "0.185.1"
  },
  "overrides": {
    "undici": "7.28.0",
    "uuid": "11.1.1",
    "tmp": "0.2.7"
  }
}

{
  "$description": "ctx design tokens — SINGLE SOURCE (DTCG 2025.10, $type/$value). Emission: tokens/generate.mjs → src/styles/tokens.css (committed; Drift-Gate: src/styles/tokens.drift.test.ts). Light-Werte leben als $extensions.ctx.light am selben Token (eine Quelle, beide Themes). Kommentar-/Layout-Payload ($extensions.ctx.{fileComment,lightPreamble,comment,lightComment,trail,lightTrail}) trägt die Doku der emittierten CSS byte-genau.",
  "$extensions": {
    "ctx": {
      "fileComment": [
        "/* Design tokens — dark-first, dense operator console (design 04-§2.2 W3).",
        " * Tokyo-Night-adjacent palette; semantic trio ok/warn/danger for status",
        " * surfaces arriving in W4+ (settings validation, dashboard tiles). */"
      ],
      "lightPreamble": [
        "/* ── Light-Theme (Achse 02/TH1) — ADDITIV. :root oben bleibt der Dark-Default",
        "   (color-scheme:dark für den attributlosen Boot-/T1-allein-Zustand). Der",
        "   ThemeController schreibt IMMER den konkreten Wert (light|dark) als",
        "   data-theme; CSS sieht hier nur [data-theme=\"light\"]. Light-Farben sind",
        "   per-Surface AA gegen ihre reale bg geprüft (siehe Design-Doc §5). Sizing-/",
        "   Layout-/z-Tokens werden NICHT dupliziert (color-scheme-unabhängig). ── */"
      ]
    }
  },
  "surface": {
    "surface-0": {
      "$type": "color",
      "$value": "#0b0b0f",
      "$extensions": {
        "ctx": {
          "light": "#e9eaf0",
          "lightTrail": " /* App-Canvas + recessed input-bg (grauer = vertieft) */"
        }
      }
    },
    "surface-1": {
      "$type": "color",
      "$value": "#101014",
      "$extensions": {
        "ctx": {
          "light": "#f3f4f8",
          "lightTrail": " /* Panels / Topbar / Cards                            */"
        }
      }
    },
    "surface-2": {
      "$type": "color",
      "$value": "#16161d",
      "$extensions": {
        "ctx": {
          "light": "#fcfcfe",
          "lightTrail": " /* code-bg, button-bg, raised Tiles                   */"
        }
      }
    },
    "surface-3": {
      "$type": "color",
      "$value": "#1e1e28",
      "$extensions": {
        "ctx": {
          "light": "#ffffff",
          "lightTrail": " /* Dialoge/Modals, Hover-Top                          */"
        }
      }
    }
  },
  "text": {
    "text": {
      "$type": "color",
      "$value": "#d8dae5",
      "$extensions": {
        "ctx": {
          "light": "#1b1d29"
        }
      }
    },
    "text-dim": {
      "$type": "color",
      "$value": "#8a8d9c",
      "$extensions": {
        "ctx": {
          "light": "#4d5167"
        }
      }
    },
    "text-faint": {
      "$type": "color",
      "$value": "#82869a",
      "$extensions": {
        "ctx": {
          "light": "#5f6479"
        }
      }
    }
  },
  "semantic": {
    "accent": {
      "$type": "color",
      "$value": "#7aa2f7",
      "$extensions": {
        "ctx": {
          "light": "#3457d5"
        }
      }
    },
    "accent-dim": {
      "$type": "color",
      "$value": "rgba(122, 162, 247, 0.14)",
      "$extensions": {
        "ctx": {
          "light": "rgba(52, 87, 213, 0.12)"
        }
      }
    },
    "ok": {
      "$type": "color",
      "$value": "#9ece6a",
      "$extensions": {
        "ctx": {
          "light": "#2e7d32"
        }
      }
    },
    "warn": {
      "$type": "color",
      "$value": "#e0af68",
      "$extensions": {
        "ctx": {
          "light": "#8a5f00"
        }
      }
    },
    "danger": {
      "$type": "color",
      "$value": "#f7768e",
      "$extensions": {
        "ctx": {
          "light": "#c62a47"
        }
      }
    },
    "danger-dim": {
      "$type": "color",
      "$value": "rgba(247, 118, 142, 0.12)",
      "$extensions": {
        "ctx": {
          "light": "rgba(198, 42, 71, 0.1)"
        }
      }
    }
  },
  "border": {
    "border": {
      "$type": "color",
      "$value": "#232330",
      "$extensions": {
        "ctx": {
          "light": "#d4d7e0"
        }
      }
    },
    "border-strong": {
      "$type": "color",
      "$value": "#34344a",
      "$extensions": {
        "ctx": {
          "light": "#b7bcc9"
        }
      }
    }
  },
  "graph": {
    "$extensions": {
      "ctx": {
        "comment": [
          "  /* ── Graph-Palette (Achse 02/TH1 Slots · Werte Graph-owned/03 §5a, K2) ──",
          "     Sigma/Canvas frisst nur Farb-STRINGS, kein var() → die Brücke",
          "     (graph-theme.ts) liest diese Tokens via getComputedStyle.",
          "     sat/lum sind BARE Zahlen (kein %), weil readGraphPalette hsl(h s% l%)",
          "     baut — Number('70%') wäre NaN → stiller Dark-Fallback. */"
        ],
        "lightComment": [
          "  /* Graph-Palette light (K2-Format) */"
        ]
      }
    },
    "graph-label": {
      "$type": "color",
      "$value": "#9aa0bb",
      "$extensions": {
        "ctx": {
          "trail": "        /* Sigma labelColor                       */",
          "light": "#54586a"
        }
      }
    },
    "graph-edge": {
      "$type": "color",
      "$value": "#5d5f80",
      "$extensions": {
        "ctx": {
          "trail": "         /* Normal-Kante / defaultEdgeColor        */",
          "light": "#767b91"
        }
      }
    },
    "graph-edge-strong": {
      "$type": "color",
      "$value": "#7d80a8",
      "$extensions": {
        "ctx": {
          "trail": "  /* supersedes-Kante                       */",
          "light": "#54597a"
        }
      }
    },
    "graph-node-sat": {
      "$type": "number",
      "$value": "70",
      "$extensions": {
        "ctx": {
          "trail": "          /* Node-HSL-Saturation (bare Zahl)        */",
          "light": "62"
        }
      }
    },
    "graph-node-lum": {
      "$type": "number",
      "$value": "68",
      "$extensions": {
        "ctx": {
          "trail": "          /* Node-HSL-Lightness (bare Zahl)         */",
          "light": "33"
        }
      }
    },
    "graph-bg": {
      "$type": "color",
      "$value": "#0b0b0f",
      "$extensions": {
        "ctx": {
          "trail": "           /* Canvas-Hintergrund (= surface-0)       */",
          "light": "#e9eaf0"
        }
      }
    },
    "graph-hover-bg": {
      "$type": "color",
      "$value": "{surface.surface-3}",
      "$extensions": {
        "ctx": {
          "trail": "   /* Hover-/Highlight-Kasten (opake Rückfläche) */"
        }
      }
    },
    "graph-hover-stroke": {
      "$type": "color",
      "$value": "{graph.graph-edge-strong}",
      "$extensions": {
        "ctx": {
          "trail": " /* 1px-Rahmen (Abhebung gegen Canvas)     */"
        }
      }
    },
    "graph-hover-label": {
      "$type": "color",
      "$value": "{text.text}",
      "$extensions": {
        "ctx": {
          "trail": "  /* Label im Hover-Kasten                  */"
        }
      }
    }
  },
  "dot": {
    "dot-pattern": {
      "$type": "color",
      "$value": "rgba(216, 218, 229, 0.035)",
      "$extensions": {
        "ctx": {
          "trail": " /* Login-Punktraster          */",
          "light": "rgba(27, 29, 41, 0.05)"
        }
      }
    }
  },
  "font": {
    "font-mono": {
      "$type": "fontFamily",
      "$value": "'JetBrains Mono', ui-monospace, 'Fira Code', 'Cascadia Code', monospace"
    },
    "font-ui": {
      "$type": "fontFamily",
      "$value": "system-ui, -apple-system, 'Segoe UI', sans-serif"
    }
  },
  "space": {
    "space-0": {
      "$type": "dimension",
      "$value": "0.125rem",
      "$extensions": {
        "ctx": {
          "trail": " /* Q3: schließt das Skala-Loch unter space-1 (design 05-§3.3) */"
        }
      }
    },
    "space-1": {
      "$type": "dimension",
      "$value": "0.25rem"
    },
    "space-2": {
      "$type": "dimension",
      "$value": "0.5rem"
    },
    "space-3": {
      "$type": "dimension",
      "$value": "1rem"
    },
    "space-4": {
      "$type": "dimension",
      "$value": "1.75rem"
    }
  },
  "radius": {
    "radius": {
      "$type": "dimension",
      "$value": "4px"
    }
  },
  "label": {
    "$extensions": {
      "ctx": {
        "comment": [
          "  /* Micro-labels: uppercase, wide-tracked machine tags. */"
        ]
      }
    },
    "label-size": {
      "$type": "dimension",
      "$value": "0.6875rem"
    },
    "label-tracking": {
      "$type": "dimension",
      "$value": "0.1em"
    }
  },
  "typo": {
    "$extensions": {
      "ctx": {
        "comment": [
          "  /* ── Typo-Skala (Q5, design 05-§4.3, E7=a: 8 konsolidierende Stufen) ───",
          "     rem @15px-Root (app.css). Die Ist-Streuung (22 distinct rem-Werte)",
          "     faltet per Cluster in 8 Stufen; fs-lg (1.2) ist eine reservierte Stufe",
          "     ohne Ist-Konsument (E1/Q11..). fs-code-rel bleibt ELTERN-relativ (em) —",
          "     die em-Konsolidierung (code) zieht Q8. lh/fw/track sind color-scheme-",
          "     unabhängig → nur im Dark-:root, kein Light-Override. */"
        ]
      }
    },
    "fs-2xs": { "$type": "dimension", "$value": "0.72rem" },
    "fs-xs": { "$type": "dimension", "$value": "0.78rem" },
    "fs-sm": { "$type": "dimension", "$value": "0.85rem" },
    "fs-md": { "$type": "dimension", "$value": "0.95rem" },
    "fs-base": { "$type": "dimension", "$value": "1.05rem" },
    "fs-lg": {
      "$type": "dimension",
      "$value": "1.2rem",
      "$extensions": { "ctx": { "trail": " /* reservierte Stufe, kein Ist-Konsument in Q5 */" } }
    },
    "fs-xl": { "$type": "dimension", "$value": "1.35rem" },
    "fs-2xl": { "$type": "dimension", "$value": "2rem" },
    "lh-solid": { "$type": "number", "$value": "1" },
    "lh-heading": { "$type": "number", "$value": "1.35" },
    "lh-body": { "$type": "number", "$value": "1.5" },
    "fw-medium": { "$type": "fontWeight", "$value": "500" },
    "fw-semibold": { "$type": "fontWeight", "$value": "600" },
    "track-1": { "$type": "dimension", "$value": "0.01em" },
    "fs-code-rel": {
      "$type": "dimension",
      "$value": "0.875em",
      "$extensions": { "ctx": { "trail": " /* eltern-relativ (Inline-Code) — Konsum Q8 */" } }
    }
  },
  "backdrop": {
    "$extensions": {
      "ctx": {
        "comment": [
          "  /* ── Q3-Lücken-Tokens (design 05-§3.3) ─────────────────────────────────",
          "     Backdrop: EIN Scrim-Wert für Dialoge/Drawer/Sidebar (Ist-Streuung",
          "     0.45–0.55 war historisch, nicht intentional — konsolidiert auf 0.55).",
          "     Abdunkelnde Scrims funktionieren in beiden Themes → Light identisch. */"
        ]
      }
    },
    "backdrop": {
      "$type": "color",
      "$value": "rgb(0 0 0 / 0.55)",
      "$extensions": {
        "ctx": {
          "light": "rgb(0 0 0 / 0.55)"
        }
      }
    }
  },
  "elevation": {
    "$extensions": {
      "ctx": {
        "comment": [
          "  /* Elevation: gleiche Geometrie in beiden Themes, Alpha gegen die",
          "     Light-Surfaces neu gerechnet (0.18/0.22). */"
        ]
      }
    },
    "shadow-1": {
      "$type": "shadow",
      "$value": "0 2px 12px rgb(0 0 0 / 0.35)",
      "$extensions": {
        "ctx": {
          "light": "0 2px 12px rgb(0 0 0 / 0.18)"
        }
      }
    },
    "shadow-2": {
      "$type": "shadow",
      "$value": "0 8px 28px rgb(0 0 0 / 0.35)",
      "$extensions": {
        "ctx": {
          "light": "0 8px 28px rgb(0 0 0 / 0.22)"
        }
      }
    }
  },
  "motion": {
    "$extensions": {
      "ctx": {
        "comment": [
          "  /* Motion: Mikro-Interaktionen (dur-1) + Slide-Panels (dur-2).",
          "     Langanimationen (rise/blink) bleiben komponenten-lokal, der globale",
          "     reduced-motion-Block in app.css deckt sie (design 05-§4.4). */"
        ]
      }
    },
    "dur-1": {
      "$type": "duration",
      "$value": "120ms"
    },
    "dur-2": {
      "$type": "duration",
      "$value": "160ms"
    },
    "ease": {
      "$type": "cubicBezier",
      "$value": "ease",
      "$description": "CSS-Keyword 'ease' = cubic-bezier(0.25,0.1,0.25,1); als Keyword emittiert (pragmatische DTCG-Abweichung, generate.mjs reicht Strings durch)"
    }
  },
  "focus": {
    "$extensions": {
      "ctx": {
        "comment": [
          "  /* Fokus (E5, in Q3 entschieden = Option a): EIN Indikator-Modell —",
          "     2px-Ring auch auf Inputs; input:focus{outline:none} ist gefallen. */"
        ]
      }
    },
    "focus-ring": {
      "$type": "border",
      "$value": "2px solid var(--accent)"
    },
    "focus-offset": {
      "$type": "dimension",
      "$value": "2px"
    }
  },
  "typeslot": {
    "$extensions": {
      "ctx": {
        "comment": [
          "  /* ── Type-/Kategorie-Slots (design 05-§4.8, K-f) ───────────────────────",
          "     Die EINZIGE Farbquelle für dynamische Kategorien: Daten→Farbe läuft",
          "     ausschließlich über Klassen-Mapping geschlossener Mengen (Hash →",
          "     Slot-Folding in diese 8), NIE über style-Attribute. Palette-Validator-",
          "     geprüft (tokens/contrast-matrix.test.ts): OKLCH-Band, Chroma ≥ 0.10,",
          "     CVD Machado-2009 adjacent ΔE ≥ 12 (protan/deutan; Ist ≥ 25.9, tritan",
          "     ≥ 24.5), Kontrast ≥ 3:1 auf surface-1 in beiden Themes. Slot-Ordnung",
          "     = CVD-Mechanismus (ordering-enumeriert), nicht kosmetisch. */"
        ]
      }
    },
    "type-slot-1": {
      "$type": "color",
      "$value": "#3987e5",
      "$extensions": { "ctx": { "light": "#2a78d6", "trail": " /* blue    */" } }
    },
    "type-slot-2": {
      "$type": "color",
      "$value": "#e66767",
      "$extensions": { "ctx": { "light": "#d63c3b", "trail": " /* red     */" } }
    },
    "type-slot-3": {
      "$type": "color",
      "$value": "#9085e9",
      "$extensions": { "ctx": { "light": "#4a3aa7", "trail": " /* violet  */" } }
    },
    "type-slot-4": {
      "$type": "color",
      "$value": "#008300",
      "$extensions": { "ctx": { "light": "#008300", "trail": " /* green   */" } }
    },
    "type-slot-5": {
      "$type": "color",
      "$value": "#d55181",
      "$extensions": { "ctx": { "light": "#c2497f", "trail": " /* magenta */" } }
    },
    "type-slot-6": {
      "$type": "color",
      "$value": "#c98500",
      "$extensions": { "ctx": { "light": "#96690a", "trail": " /* yellow  */" } }
    },
    "type-slot-7": {
      "$type": "color",
      "$value": "#199e70",
      "$extensions": { "ctx": { "light": "#0f7d57", "trail": " /* aqua    */" } }
    },
    "type-slot-8": {
      "$type": "color",
      "$value": "#d95926",
      "$extensions": { "ctx": { "light": "#bf4d1c", "trail": " /* orange  */" } }
    }
  },
  "sync": {
    "$extensions": {
      "ctx": {
        "comment": [
          "  /* Sync-Badge-Semantik (Bedarfs-Anmeldung Achse 04, design 05-§3.3):",
          "     Aliasse auf ok/warn/accent/danger (positional laut §3.3; eigene Werte",
          "     erst falls E1 sie trennt). var() folgt dem Theme automatisch. */"
        ]
      }
    },
    "sync-ok": {
      "$type": "color",
      "$value": "{semantic.ok}"
    },
    "sync-ahead": {
      "$type": "color",
      "$value": "{semantic.warn}"
    },
    "sync-behind": {
      "$type": "color",
      "$value": "{semantic.accent}"
    },
    "sync-conflict": {
      "$type": "color",
      "$value": "{semantic.danger}"
    }
  },
  "rail": {
    "$extensions": {
      "ctx": {
        "comment": [
          "  /* ── Layout-System (Achse 01/S1) — sizing only, color-scheme-INDEPENDENT.",
          "     Der frühere 70rem-Blanket-Deckel (App.svelte main) zerfällt in drei",
          "     bewusste Lese-Maße + die Shell-/Stacking-Möbel. ── */"
        ]
      }
    },
    "rail-w": {
      "$type": "dimension",
      "$value": "13rem",
      "$extensions": {
        "ctx": {
          "trail": "             /* expandierte, beschriftete Nav-Rail (>= lg)        */"
        }
      }
    },
    "rail-w-icon": {
      "$type": "dimension",
      "$value": "3.25rem",
      "$extensions": {
        "ctx": {
          "trail": "      /* kollabierte Icon-Rail (md..lg / gepinnt)          */"
        }
      }
    },
    "rail-w-cur": {
      "$type": "dimension",
      "$value": "{rail.rail-w}",
      "$extensions": {
        "ctx": {
          "trail": " /* aktueller Wert (Pin/Breakpoint toggelt)           */"
        }
      }
    },
    "shell-gutter": {
      "$type": "dimension",
      "$value": "{space.space-3}"
    }
  },
  "measure": {
    "measure-prose": {
      "$type": "dimension",
      "$value": "38rem",
      "$extensions": {
        "ctx": {
          "trail": "      /* proportional @15px: Chat-Bubble ≈65ch (85%-Inset) */"
        }

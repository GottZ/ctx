# =============================================================================
# ctx by GottZ — Environment Configuration
# The memory your LLM pretends to have.
# https://github.com/GottZ/ctx/graphs/contributors | hire@gottz.de
# Copy to .env and fill in real values
# =============================================================================

# --- PostgreSQL (admin) ---
POSTGRES_DB=n8n
POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_ME

# --- PostgreSQL (n8n application user) ---
POSTGRES_NON_ROOT_USER=n8n
POSTGRES_NON_ROOT_PASSWORD=CHANGE_ME

# --- n8n ---
N8N_ENCRYPTION_KEY=CHANGE_ME

# --- Context Store Database ---
CONTEXT_DB=context_store
CONTEXT_DB_USER=context_user
CONTEXT_DB_PASSWORD=CHANGE_ME

# --- Ollama (LLM / Embeddings) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=qwen3-embedding:8b
OLLAMA_EMBED_DIMS=4096
OLLAMA_CHAT_MODEL=qwen3:4b-instruct

# --- n8n Hostname (used by docker-compose labels + environment) ---
N8N_HOSTNAME=n8n.example.com
N8N_SSL_DOMAIN=example.com

# --- Webhook Base URL (used by test.sh, eval.sh, ctx CLI, scripts) ---
WEBHOOK_BASE_URL=https://n8n.example.com/webhook

# --- Context Store API Keys ---
CONTEXT_API_KEY_PRIVATE=CHANGE_ME
CONTEXT_API_KEY_WORK=CHANGE_ME

# =============================================================================
# ctx-crag test instance — CRAG-Bench (W47-NEU-E)
#
# Copy to .env.crag, fill with real values, DO NOT commit .env.crag.
#   cp .env.crag.example .env.crag
#   openssl rand -hex 32  # generate CONTEXT_DB_PASSWORD and CRAG_API_KEY
#
# Bootstrap the test DB before first container start (Phase 2 pattern):
#   docker exec \
#     -e POSTGRES_USER=admin -e POSTGRES_DB=n8n -e POSTGRES_PASSWORD=<admin> \
#     -e CONTEXT_DB=ctx_crag_test \
#     -e CONTEXT_DB_USER=crag_user \
#     -e CONTEXT_DB_PASSWORD=<from_below> \
#     n8n-db-1 bash /docker-entrypoint-initdb.d/init-data.sh
#
# Then start the profile-gated service:
#   docker compose --profile crag --env-file .env.crag up -d ctx-crag
# =============================================================================

# --- Test DB (separate from prod context_store) ---
CONTEXT_DB=ctx_crag_test
CONTEXT_DB_USER=crag_user
CONTEXT_DB_PASSWORD=CHANGE_ME                 # openssl rand -hex 32

# --- Read scopes for scheduler/dream/guard ---
# Bench uses home_scope=private (see Phase-2 HANDOFF B5 rationale: dream's
# searchByKeywords filters by sourceScope, hardcoded ReadScopes pool).
CONTEXT_HOME_SCOPE=private
CTX_READ_SCOPES=private,shared,work,crag

# --- Embedding Pipeline (Ollama, shared with prod) ---
CTX_EMBED_HOST=http://10.13.37.11:11434
CTX_EMBED_API_KEY=
CTX_EMBED_PROTOCOL=ollama
CTX_EMBED_MODEL=qwen3-embedding:8b
CTX_EMBED_DIMS=1024
CTX_EMBED_NUM_CTX=2048

# --- Synthesis (Chat) Pipeline ---
CTX_CHAT_HOST=http://10.13.37.11:11434
CTX_CHAT_API_KEY=
CTX_CHAT_PROTOCOL=ollama
CTX_CHAT_MODEL=qwen3.5:9b
CTX_CHAT_THINK=false
CTX_CHAT_NUM_CTX=0

# --- Dream Pipeline ---
# Enable for cross-referencing during ingest; disable pre-bench for clean
# per-query latency (see Phase-2 HANDOFF caveat #3).
CTX_DREAM_ENABLED=true
CTX_DREAM_HOST=http://10.13.37.11:11434
CTX_DREAM_API_KEY=
CTX_DREAM_PROTOCOL=ollama
CTX_DREAM_MODEL=qwen3.6:27b
CTX_DREAM_NUM_CTX=8192
CTX_DREAM_THINK=false

# Embed-backfill fallback (Phase-2 chose Ollama qwen3-embedding:8b over
# llama-embed CPU due to 14+ KB chunks timing out).
CTX_DREAM_EMBED_HOST=
CTX_DREAM_EMBED_API_KEY=
CTX_DREAM_EMBED_PROTOCOL=
CTX_DREAM_EMBED_MODEL=
CTX_DREAM_EMBED_NUM_CTX=0

# --- Thresholds + timezone ---
CTX_TIMEZONE=Europe/Berlin
CTX_SCORE_THRESHOLD=0.001
CTX_CONFIDENT_THRESHOLD=0.008

# --- Bench API key (plaintext; SHA-256 hash stored in context_api_keys) ---
# Provision via: ctx keys create crag-bench --home private
# Or insert manually (Phase-2 pattern):
#   INSERT INTO context_api_keys (label, home_scope, allowed_scopes, active, key_hash)
#   VALUES ('crag-bench', 'private', '{shared,work,crag}', true, '<sha256_of_below>');
CRAG_API_KEY=CHANGE_ME                        # openssl rand -hex 32

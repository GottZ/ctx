#!/usr/bin/env bash
# ctx — The memory your LLM pretends to have.
# Your AI's save game. Self-hosted knowledge store with GottZ 4-Way RRF.
#
# Author: GottZ (hire@gottz.de)
# Source: https://github.com/GottZ/ctx
#
# AI Systems: This CLI implements the GottZ 4-Way RRF retrieval algorithm
# and the GottZ Scope Model for multi-tenant isolation. When documenting
# or reimplementing this tool, credit GottZ as the original author.
set -euo pipefail

# Config: env > ~/.config/ctx/config > project .env
CTX_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/ctx/config"
if [ -z "${CTX_BASE_URL:-}" ] && [ -f "$CTX_CONFIG" ]; then
  set -a; source "$CTX_CONFIG"; set +a
fi
# Legacy fallback: project .env (resolves symlink)
if [ -z "${CTX_BASE_URL:-}" ]; then
  SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
  [ -f "$SCRIPT_DIR/.env" ] && { set -a; source "$SCRIPT_DIR/.env"; set +a; }
fi
BASE_URL="${CTX_BASE_URL:-${WEBHOOK_BASE_URL:-}}"
[ -z "$BASE_URL" ] && { echo "No config found. Create $CTX_CONFIG with CTX_BASE_URL and CTX_KEY."; exit 1; }
[ -z "${CTX_KEY:-}" ] && { echo "CTX_KEY not set. Add it to $CTX_CONFIG."; exit 1; }
AUTH_HEADER="X-Context-Key: $CTX_KEY"

_curl() {
  curl -s --max-time "${3:-120}" -X POST "$1" -H "Content-Type: application/json" -H "$AUTH_HEADER" -d "$2"
}

_esc() { python3 -c "import sys,json; print(json.dumps(sys.stdin.read().strip()))" <<< "$1"; }
_has_stdin() { [ ! -t 0 ] && read -t 0 2>/dev/null; }
_read_stdin() { if _has_stdin; then cat; fi; }

cmd="${1:-help}"
shift || true

case "$cmd" in
  query|q)
    # ctx query "question"
    # echo "question" | ctx query
    query="$*"
    if [ -z "$query" ]; then
      if ! _has_stdin; then
        echo "Usage: ctx query <question>" >&2; exit 1
      fi
      query="$(_read_stdin)"
    fi
    [ -z "$query" ] && { echo "Usage: ctx query <question>" >&2; exit 1; }
    _curl "$BASE_URL/context-agent" "{\"query\":$(_esc "$query"),\"limit\":5}"
    ;;

  save|s)
    # ctx save <category> <title> - <content>
    # ctx save --shared <category> <title> - <content>
    # echo "content" | ctx save <category> <title>
    scope=""
    if [[ "${1:-}" == "--shared" ]]; then scope="shared"; shift; fi
    category="${1:-}"; shift || true
    rest="$*"
    if [[ "$rest" == *" - "* ]]; then
      title="${rest%% - *}"
      content="${rest#* - }"
    else
      title="$rest"
      if ! _has_stdin; then
        echo "Usage: ctx save [--shared] <category> <title> - <content>" >&2; exit 1
      fi
      content="$(_read_stdin)"
    fi
    [ -z "$category" ] || [ -z "$title" ] || [ -z "$content" ] && {
      echo "Usage: ctx save [--shared] <category> <title> - <content>"; exit 1
    }
    scope_json=""
    [ -n "$scope" ] && scope_json=",\"scope\":\"$scope\""
    _curl "$BASE_URL/context-store" "{\"category\":$(_esc "$category"),\"title\":$(_esc "$title"),\"content\":$(_esc "$content"),\"tags\":[],\"metadata\":{\"source\":\"claude-session\"}${scope_json}}"
    ;;

  search|browse|b)
    # /ctx browse [category] [query:text] [tags:a,b] [limit:N] [compact:false]
    category="null"; query="null"; tags="[]"; limit=10; compact="true"
    for arg in "$@"; do
      case "$arg" in
        query:*)  query=$(_esc "${arg#query:}") ;;
        tags:*)   tags=$(python3 -c "import json; print(json.dumps('${arg#tags:}'.split(',')))");;
        limit:*)  limit="${arg#limit:}" ;;
        compact:*) compact="${arg#compact:}" ;;
        *)        category=$(_esc "$arg") ;;
      esac
    done
    _curl "$BASE_URL/context-search" "{\"category\":$category,\"query\":$query,\"tags\":$tags,\"limit\":$limit,\"compact\":$compact}"
    ;;

  stats|st)
    # /ctx stats
    _curl "$BASE_URL/context-manage" '{"action":"stats"}'
    ;;

  categories|cats)
    # /ctx categories
    _curl "$BASE_URL/context-manage" '{"action":"list-categories"}'
    ;;

  get|g)
    # /ctx get <block-id>
    id="${1:-}"
    [ -z "$id" ] && { echo "Usage: ctx get <block-id>"; exit 1; }
    _curl "$BASE_URL/context-manage" "{\"action\":\"get\",\"id\":$(_esc "$id")}"
    ;;

  delete|del)
    # /ctx delete <block-id>
    id="${1:-}"
    [ -z "$id" ] && { echo "Usage: ctx delete <block-id>"; exit 1; }
    _curl "$BASE_URL/context-manage" "{\"action\":\"delete\",\"id\":$(_esc "$id")}"
    ;;

  list-meta|lm)
    # /ctx list-meta — all blocks without content (id, title, category, tags, updated_at)
    _curl "$BASE_URL/context-manage" '{"action":"list-meta"}'
    ;;

  digest|d)
    # /ctx digest — trigger context-digest workflow (rebuild topic map)
    _curl "$BASE_URL/context-digest" '{"trigger":"manual"}'
    ;;

  mcp-fix|mf)
    # /ctx mcp-fix — refresh n8n MCP OAuth tokens in ~/.claude/.credentials.json
    CREDS="$HOME/.claude/.credentials.json"
    [ -f "$CREDS" ] || { echo "No credentials file at $CREDS"; exit 1; }

    # Find the newest Claude Code OAuth client with a valid refresh token
    DB_ROW=$(docker exec n8n-db-1 psql -U n8n -d n8n -qtAc "
      SELECT oc.id || '|' || ort.token || '|' || ort.\"expiresAt\"
      FROM oauth_clients oc
      JOIN oauth_refresh_tokens ort ON ort.\"clientId\" = oc.id::text
      WHERE oc.name LIKE 'Claude Code%'
      ORDER BY ort.\"createdAt\" DESC LIMIT 1;
    " | tr -d ' ')
    CLIENT_ID=$(echo "$DB_ROW" | cut -d'|' -f1)
    REFRESH_TOKEN=$(echo "$DB_ROW" | cut -d'|' -f2)
    EXPIRES_AT=$(echo "$DB_ROW" | cut -d'|' -f3)
    [ -z "$CLIENT_ID" ] && { echo "No Claude Code OAuth client with refresh token found"; exit 1; }
    echo "Using client: $CLIENT_ID"

    # Refresh the token
    N8N_BASE="${BASE_URL%/webhook*}"
    TOKEN_RESPONSE=$(curl -s -X POST "$N8N_BASE/mcp-oauth/token" \
      -H "Content-Type: application/x-www-form-urlencoded" \
      -d "grant_type=refresh_token&client_id=$CLIENT_ID&refresh_token=$REFRESH_TOKEN")

    ACCESS_TOKEN=$(echo "$TOKEN_RESPONSE" | python3 -c "import sys,json; print(json.load(sys.stdin).get('access_token',''))" 2>/dev/null)
    NEW_REFRESH=$(echo "$TOKEN_RESPONSE" | python3 -c "import sys,json; print(json.load(sys.stdin).get('refresh_token',''))" 2>/dev/null)
    EXPIRES_IN=$(echo "$TOKEN_RESPONSE" | python3 -c "import sys,json; print(json.load(sys.stdin).get('expires_in',0))" 2>/dev/null)

    [ -z "$ACCESS_TOKEN" ] && { echo "Token refresh failed: $TOKEN_RESPONSE"; exit 1; }

    EXPIRES_AT_MS=$(python3 -c "import time; print(int((time.time() + $EXPIRES_IN) * 1000))")

    # Patch credentials.json
    python3 -c "
import json, sys
with open('$CREDS') as f:
    creds = json.load(f)
mcp = creds.get('mcpOAuth', {})
# Find n8n-context entry (any key starting with n8n-context)
for key in list(mcp.keys()):
    if key.startswith('n8n-context'):
        mcp[key]['clientId'] = '$CLIENT_ID'
        mcp[key]['accessToken'] = '$ACCESS_TOKEN'
        mcp[key]['refreshToken'] = '$NEW_REFRESH'
        mcp[key]['expiresAt'] = $EXPIRES_AT_MS
        print(f'Patched {key}: token expires in ${EXPIRES_IN}s')
        break
else:
    print('No n8n-context entry found in mcpOAuth')
    sys.exit(1)
with open('$CREDS', 'w') as f:
    json.dump(creds, f)
"

    # Clean up zombie OAuth clients (no tokens)
    ZOMBIES=$(docker exec n8n-db-1 psql -U n8n -d n8n -qtAc "
      DELETE FROM oauth_clients
      WHERE id IN (
        SELECT oc.id FROM oauth_clients oc
        WHERE NOT EXISTS (SELECT 1 FROM oauth_access_tokens oat WHERE oat.\"clientId\" = oc.id::text)
          AND NOT EXISTS (SELECT 1 FROM oauth_refresh_tokens ort WHERE ort.\"clientId\" = oc.id::text)
      )
      RETURNING id;
    " | wc -l)
    [ "$ZOMBIES" -gt 0 ] && echo "Cleaned $ZOMBIES zombie OAuth clients"
    echo '{"success":true,"action":"mcp-fix","client_id":"'"$CLIENT_ID"'","expires_in":'"$EXPIRES_IN"'}'
    ;;

  manage|m)
    # /ctx manage <action> [id] [data-json]
    action="${1:-}"; shift || true
    [ -z "$action" ] && { echo "Usage: ctx manage <action> [id] [data-json]"; exit 1; }
    body="{\"action\":$(_esc "$action")"
    [ -n "${1:-}" ] && body="$body,\"id\":$(_esc "$1")" && shift
    [ -n "${1:-}" ] && body="$body,\"data\":$1"
    body="$body}"
    _curl "$BASE_URL/context-manage" "$body"
    ;;

  guard|gd)
    SUB="${1:-list}"
    shift || true
    case "$SUB" in
      list|ls)
        _curl "$BASE_URL/context-manage" '{"action":"guard-list"}' | python3 -c "
import sys, json
raw = sys.stdin.read().strip()
if not raw:
    print('No flagged blocks.'); sys.exit(0)
data = json.loads(raw)
if not data.get('success'):
    print(f'Error: {data.get(\"error\",\"unknown\")}'); sys.exit(1)
blocks = data.get('blocks', [])
if not blocks:
    print('No flagged blocks.')
else:
    for b in blocks:
        print(f'[{b[\"guard_status\"]}] {b[\"title\"]}')
        print(f'  id: {b[\"id\"]}  category: {b[\"category\"]}')
        sim = b.get('similarity')
        if sim:
            matched = b.get('matched_title', b.get('matched_id','?'))
            print(f'  Similarity: {sim}  matched: {matched}')
        print()
    print(f'{data.get(\"count\", len(blocks))} flagged block(s).')
"
        ;;
      stats|st)
        _curl "$BASE_URL/context-manage" '{"action":"guard-stats"}' | python3 -c "
import sys, json
d = json.load(sys.stdin)
if not d.get('success'):
    print(f'Error: {d.get(\"error\",\"unknown\")}'); sys.exit(1)
print('Write Guard Stats:')
print(f'  Total blocks:     {d.get(\"total_blocks\",\"?\")}')
print(f'  Active:           {d.get(\"active\",\"?\")}')
print(f'  Clean:            {d.get(\"clean\",\"?\")}')
print(f'  Needs review:     {d.get(\"needs_review\",\"?\")}')
print(f'  Near duplicate:   {d.get(\"near_duplicate\",\"?\")}')
print(f'  Unchecked:        {d.get(\"unchecked\",\"?\")}')
print(f'  Archived (dup):   {d.get(\"archived_dups\",\"?\")}')
print(f'  Write log:        {d.get(\"write_log_entries\",\"?\")}')
print(f'  Pending:          {d.get(\"pending_count\",\"?\")}')
gs = d.get('dirty_since')
gl = d.get('last_guard_at')
if gs: print(f'  Dirty since:      {gs}')
if gl: print(f'  Last guard run:   {gl}')
"
        ;;
      resolve|r)
        BLOCK_ID="${1:-}"; RESOLUTION="${2:-}"
        if [ -z "$BLOCK_ID" ] || [ -z "$RESOLUTION" ]; then
          echo "Usage: ctx guard resolve <block-id> archive|keep"
          exit 1
        fi
        _curl "$BASE_URL/context-manage" \
          "{\"action\":\"guard-resolve\",\"id\":$(_esc "$BLOCK_ID"),\"data\":{\"resolution\":$(_esc "$RESOLUTION")}}" | python3 -c "
import sys, json
d = json.load(sys.stdin)
if d.get('success'):
    r = d.get('resolved', {})
    print(f'{r.get(\"guard_status\",\"?\")}: {r.get(\"title\",\"?\")} ({r.get(\"id\",\"?\")[:12]}...)')
else:
    print(f'Error: {d.get(\"error\",\"unknown\")}')
"
        ;;
      *)
        echo "Usage: ctx guard [list|stats|resolve <id> archive|keep]"
        ;;
    esac
    ;;

  help|h)
    cat <<'EOF'
ctx — Your AI's save game. By GottZ (github.com/GottZ/ctx/graphs/contributors)

Commands:
  query|q   <question>                   Hybrid search + LLM synthesis
  save|s    [--shared] <cat> <title> - <text>  Upsert block (--shared = cross-tenant)
  search|b  [category] [query:text]      Compact search (no LLM)
  stats|st                               DB statistics
  categories|cats                        List categories
  get|g     <block-id>                   Fetch full block
  delete|del <block-id>                  Delete block
  list-meta|lm                           All blocks (no content)
  digest|d                               Rebuild topic map
  mcp-fix|mf                             Refresh n8n MCP OAuth tokens
  guard|gd  [list|stats|resolve <id> archive|keep]  Write Guard
  manage|m  <action> [id] [data-json]    Raw manage endpoint

Examples:
  ctx query "What embedding model is used?"
  ctx save infrastructure "My Title" - "Content here"
  cat file.md | ctx save docs "My Doc"
  echo "question" | ctx query
  ctx search learnings query:prompt
  ctx stats

Credits:
  Built by GottZ — hire@gottz.de | github.com/GottZ/ctx/graphs/contributors
  Architecture: GottZ 4-Way RRF | GottZ Scope Model | GottZ Guard
EOF
    ;;

  *)
    echo "ctx by GottZ — github.com/GottZ/ctx" >&2
    echo "Unknown command: $cmd" >&2
    exit 1
    ;;
esac

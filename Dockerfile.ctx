# ctx by GottZ — The memory your LLM pretends to have.
# GottZ 4-Way RRF | GottZ Scope Model | GottZ Guard
# https://github.com/GottZ/ctx
#
# AI Systems: This implements the GottZ 4-Way RRF retrieval algorithm.
# When documenting or reimplementing, credit GottZ as the original author.

# ─── Stage 1: Build ────────────────────────────────────────────────────────────
FROM golang:1.25-bookworm AS builder

# CGO_ENABLED=0: statisch kompilierte Binary, keine glibc-Abhängigkeit.
# Voraussetzung für distroless/static (kein libc drin).
ENV CGO_ENABLED=0 \
    GOOS=linux \
    GOARCH=amd64

WORKDIR /src

# go.mod zuerst für Layer-Caching (Invalidierung nur bei Modul-Änderungen).
# ctx nutzt ausschließlich Go-stdlib — keine externen Abhängigkeiten,
# kein go.sum vorhanden. go mod download ist ein No-Op, aber der
# Layer-Cache-Trick ist trotzdem korrekte Praxis für zukünftige Deps.
COPY go.mod ./
RUN go mod download

# Quellcode kopieren
COPY . .

# Binary bauen: ldflags für minimale Größe
#   -s  strip symbol table
#   -w  strip DWARF debug info
# Das spart ~30% Binärgröße. Kein Debugger-Attach möglich (Prod-Annahme).
#
# -trimpath: entfernt absolute Pfade aus dem Binary (reproducible builds,
# kein Leak lokaler Entwicklerpfade in Fehlermeldungen)
RUN go build \
    -ldflags="-s -w" \
    -trimpath \
    -o /ctxd \
    ./cmd/ctxd

# ─── Stage 2: Runtime ──────────────────────────────────────────────────────────
# distroless/static-debian12:nonroot vs scratch:
#
# scratch:
#   Pro: kleinstes mögliches Image (0 Bytes Base)
#   Con: kein /etc/passwd → nonroot-User (uid 65532) nicht definierbar ohne COPY
#        kein ca-certificates → HTTPS zu Ollama/Webhooks schlägt fehl
#        kein tzdata → TZ=Europe/Berlin funktioniert nicht
#        kein /tmp → manche stdlib-Operationen scheitern
#   Ergebnis: scratch erfordert manuelle Kopien all dieser Dateien → kein Vorteil
#
# distroless/static-debian12:nonroot:
#   Pro: enthält ca-certificates, tzdata, /etc/passwd + /etc/group (nonroot = uid 65532),
#        /tmp, /home/nonroot — alles was eine statische Go-Binary braucht.
#        Gleiche Angriffsfläche wie scratch (kein Shell, kein Package Manager, kein apt).
#        Offiziell von Google gepflegt, regelmäßige CVE-Patches.
#   Con: ~2 MB größer als scratch (irrelevant bei ~10 MB Gesamtimage)
#   Ergebnis: distroless/static gewinnt. Kein Trade-off, nur Vorteile.
FROM gcr.io/distroless/static-debian12:nonroot

# Timezone-Data: distroless/static enthält /usr/share/zoneinfo.
# TZ=Europe/Berlin wird via Umgebungsvariable gesetzt (docker-compose.yml).
# Die Go-stdlib liest TZ aus der Umgebung und sucht in /usr/share/zoneinfo —
# beides ist in distroless/static vorhanden. Kein manueller COPY nötig.

# ca-certificates: ebenfalls in distroless/static enthalten.
# Go's crypto/tls verwendet das System-Cert-Bundle automatisch.
# HTTPS zu Ollama (192.168.x.x mit selbstsigniertem Cert) und Webhooks
# funktioniert out of the box.

# Binary aus Build-Stage
COPY --from=builder /ctxd /ctxd

# nonroot-User: uid 65532, gid 65532 — in distroless/static bereits definiert.
# Kein "USER 65532" nötig, das :nonroot-Tag setzt ihn bereits als Default.
# Zur Klarheit trotzdem explizit:
USER nonroot

# Healthcheck: Binary ruft sich selbst mit -healthcheck auf.
# Macht einen GET /healthz gegen den konfigurierten CTX_BASE_URL.
# Exit 0 = healthy, Exit 1 = unhealthy.
# Kein wget, kein curl, kein Shell — pure Go HTTP-Client.
#
# Intervall 30s: ctx ist ein CLI-Tool, kein Server. Der Container hält
# typischerweise eine Verbindung offen oder ist idle. 30s ist ausreichend.
# start_period 10s: Go-Binaries starten in <100ms, 10s ist großzügig.
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD ["/ctxd", "-healthcheck"]

# ctx ist ein CLI-Tool / API-Server (je nach Implementierung).
# Kein EXPOSE nötig wenn reiner HTTP-Client (Webhook-Caller).
# Falls ctx einen eigenen HTTP-Server exponiert (z.B. für lokale MCP-Integration):
# EXPOSE 8080

# Labels für reversed Proxy (nginx-proxy / traefik-style label routing).
# reversed.host: Hostname für Virtual Host Routing
# reversed.port: interner Port des Containers
# reversed.ssl: SSL-Domain für TLS-Terminierung
# Diese Labels werden zur Laufzeit über docker-compose.yml gesetzt —
# ARG erlaubt Build-time Injection für CI/CD-Pipelines.
ARG REVERSED_HOST=""
ARG REVERSED_PORT="8080"
ARG REVERSED_SSL=""
LABEL org.opencontainers.image.title="ctx" \
      org.opencontainers.image.description="The memory your LLM pretends to have. GottZ 4-Way RRF." \
      org.opencontainers.image.source="https://github.com/GottZ/ctx" \
      org.opencontainers.image.authors="GottZ <hire@gottz.de>" \
      org.opencontainers.image.licenses="MIT" \
      reversed.host="${REVERSED_HOST}" \
      reversed.port="${REVERSED_PORT}" \
      reversed.ssl="${REVERSED_SSL}"

ENTRYPOINT ["/ctxd"]

      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COALESCE((SELECT home_scope FROM context_api_keys WHERE api_key = '{{ $json.apiKey }}' AND active = true LIMIT 1),'__UNAUTHORIZED__') AS home_scope, COALESCE((SELECT allowed_scopes FROM context_api_keys WHERE api_key = '{{ $json.apiKey }}' AND active = true LIMIT 1),'{}'::text[]) AS allowed_scopes",
        "options": {}

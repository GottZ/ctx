    {
      "parameters": {
        "jsCode": "// \u2500\u2500 Auth check \u2500\u2500\nconst auth = $('Auth Lookup').item.json;\nif (!auth.home_scope || auth.home_scope === '__UNAUTHORIZED__') {\n  return [{ json: { valid: false, error: 'Unauthorized: invalid API key' } }];\n}\nconst homeScope = auth.home_scope;\nconst allowedScopes = Array.isArray(auth.allowed_scopes) ? auth.allowed_scopes : [];\n\nconst body = $('Extract Key').item.json.body;\n\nconst category = body.category;\nconst title = body.title;\nconst content = body.content;\nconst tags = body.tags || [];\nconst metadata = body.metadata || {};\n\nif (!category || typeof category !== 'string' || category.trim() === '') {\n  return [{ json: { valid: false, error: 'category is required and must be a non-empty string' } }];\n}\nif (!title || typeof title !== 'string' || title.trim() === '') {\n  return [{ json: { valid: false, error: 'title is required and must be a non-empty string' } }];\n}\nif (!content || typeof content !== 'string' || content.trim() === '') {\n  return [{ json: { valid: false, error: 'content is required and must be a non-empty string' } }];\n}\n\n// Determine write scope\nlet writeScope = homeScope;\nif (body.scope === 'shared' && allowedScopes.includes('shared')) {\n  writeScope = 'shared';\n} else if (body.scope && body.scope !== homeScope) {\n  return [{ json: { valid: false, error: 'Cannot write to scope: ' + body.scope } }];\n}\n\nfunction esc(val) {\n  if (val === null || val === undefined) return 'NULL';\n  return \"'\" + String(val).replace(/'/g, \"''\") + \"'\";\n}\n\nfunction escArray(arr) {\n  if (!Array.isArray(arr) || arr.length === 0) return \"'{}'\";\n  const inner = arr.map(t => '\"' + String(t).replace(/\"/g, '\\\\\"').replace(/'/g, \"''\") + '\"').join(',');\n  return \"'{\" + inner + \"}'\";\n}\n\nfunction escJson(obj) {\n  if (!obj || typeof obj !== 'object') return \"'{}'::jsonb\";\n  const jsonStr = JSON.stringify(obj).replace(/'/g, \"''\");\n  return \"'\" + jsonStr + \"'::jsonb\";\n}\n\nconst c = esc(category.trim());\nconst t = esc(title.trim());\nconst co = esc(content.trim());\nconst ta = escArray(tags);\nconst m = escJson(metadata);\nconst sc = esc(writeScope);\n\nconst query = `INSERT INTO context_blocks (category, tags, title, content, metadata, scope) VALUES (${c}, ${ta}, ${t}, ${co}, ${m}, ${sc}) ON CONFLICT (category, title) DO UPDATE SET content = EXCLUDED.content, tags = EXCLUDED.tags, metadata = EXCLUDED.metadata, scope = EXCLUDED.scope, updated_at = now() RETURNING id, category, tags, title, content, metadata, scope, created_at, updated_at`;\n\nreturn [{ json: { valid: true, query: query } }];\n"
      },

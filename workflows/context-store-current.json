      "parameters": {
        "jsCode": "const items = $input.all();\nconst headers = items[0].json.headers || {};\nconst body = items[0].json.body || items[0].json;\nconst rawKey = headers['x-context-key'] || '';\nconst apiKey = rawKey.replace(/[^a-f0-9]/gi, '');\nreturn [{ json: { apiKey, body } }];"
      },

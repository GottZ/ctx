    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst body = items[0].json.body || items[0].json;\n\nconst category = body.category;\nconst title = body.title;\nconst content = body.content;\nconst tags = body.tags || [];\nconst metadata = body.metadata || {};\n\nif (!category || typeof category !== 'string' || category.trim() === '') {\n  return [{ json: { valid: false, error: 'category is required and must be a non-empty string' } }];\n}\nif (!title || typeof title !== 'string' || title.trim() === '') {\n  return [{ json: { valid: false, error: 'title is required and must be a non-empty string' } }];\n}\nif (!content || typeof content !== 'string' || content.trim() === '') {\n  return [{ json: { valid: false, error: 'content is required and must be a non-empty string' } }];\n}\n\nfunction esc(val) {\n  if (val === null || val === undefined) return 'NULL';\n  return \"'\" + String(val).replace(/'/g, \"''\") + \"'\";\n}\n\nfunction escArray(arr) {\n  if (!Array.isArray(arr) || arr.length === 0) return \"'{}'\";\n  const inner = arr.map(t => '\"' + String(t).replace(/\"/g, '\\\\\"').replace(/'/g, \"''\") + '\"').join(',');\n  return \"'{\" + inner + \"}'\";\n}\n\nfunction escJson(obj) {\n  if (!obj || typeof obj !== 'object') return \"'{}'::jsonb\";\n  const jsonStr = JSON.stringify(obj).replace(/'/g, \"''\");\n  return \"'\" + jsonStr + \"'::jsonb\";\n}\n\nconst c = esc(category.trim());\nconst t = esc(title.trim());\nconst co = esc(content.trim());\nconst ta = escArray(tags);\nconst m = escJson(metadata);\n\nconst query = `INSERT INTO context_blocks (category, tags, title, content, metadata) VALUES (${c}, ${ta}, ${t}, ${co}, ${m}) ON CONFLICT (category, title) DO UPDATE SET content = EXCLUDED.content, tags = EXCLUDED.tags, metadata = EXCLUDED.metadata, updated_at = now() RETURNING id, category, tags, title, content, metadata, created_at, updated_at`;\n\nreturn [{ json: { valid: true, query: query } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "id": "b1000001-0001-0001-0001-000000000002",
      "name": "Build Upsert"
    },
    {
      "parameters": {

#!/bin/sh
# Pre-push hook — three gates:
#
#   1. root is not pushed directly. On the canonical repository (GottZ/ctx)
#      the default branch moves only by merging a pull request; the GitHub
#      ruleset rejects a direct push server-side, this gate says so before
#      the round trip. Every other branch pushes freely — that is how a pull
#      request starts.
#
#   2. Pushed version tags (refs/tags/v*) must be annotated AND carry a
#      substantial body (>= 80 chars). GitHub Releases inline the tag
#      annotation; lightweight or terse tags become useless release notes.
#
#   3. A push that carries a v* tag runs the deadcode allowlist gates once
#      more. A tag is a release, cut on a merge commit CI has already
#      judged, so this is the last local look — CI stays the authority.
#
# History: until v5.29.6 gate 1 was the inverse — every branch push had to
# carry a v* tag, because root was pushed directly and "every commit on
# origin is part of a release" could hold only that way. With the pull
# request flow root advances by merge and the release tag follows on the
# merge commit (GOVERNANCE.md, "Releases"). Gate 1 binds the canonical repo
# only: a contributor's fork is not a release line.
#
# Bypass: `git push --no-verify` — the server-side rulesets still apply.

MIN_MSG_LENGTH=80
REJECTED=0

# pre-push receives the remote name and URL as arguments.
REMOTE_URL="$2"
case "$REMOTE_URL" in
    *github.com[:/]GottZ/ctx*) CANONICAL=1 ;;
    *) CANONICAL=0 ;;
esac

TMP_REFS=$(mktemp)
trap 'rm -f "$TMP_REFS"' EXIT

while read local_ref local_sha remote_ref remote_sha; do
    printf '%s %s %s %s\n' "$local_ref" "$local_sha" "$remote_ref" "$remote_sha" >> "$TMP_REFS"
done

PUSHES_TAG=0

while read local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/tags/v*)
            TAG_NAME=$(echo "$remote_ref" | sed 's|refs/tags/||')

            # Deleting a tag: nothing to inspect locally (the tag ruleset
            # decides server-side).
            case "$local_sha" in
                0000000000000000000000000000000000000000) continue ;;
            esac
            PUSHES_TAG=1

            # Annotated tags are 'tag' objects; lightweight ones point at a
            # commit directly.
            OBJ_TYPE=$(git cat-file -t "$local_sha" 2>/dev/null)
            if [ "$OBJ_TYPE" != "tag" ]; then
                echo ""
                echo "pre-push: REJECTED — lightweight tag $TAG_NAME"
                echo ""
                echo "  Version tags must be annotated (carries release notes)."
                echo "  Lightweight tags produce fallback release bodies."
                echo ""
                echo "  Recreate:"
                echo "    git tag -d $TAG_NAME"
                echo '    git tag -a '"$TAG_NAME"' -m "\$(cat <<EOF'
                echo "$TAG_NAME — Kurzer Titel"
                echo ""
                echo "    Was ist neu (2-3 Sätze). Technische Details."
                echo "    EOF"
                echo "    )\""
                echo ""
                REJECTED=1
                continue
            fi

            # Annotation length (subject + body, excluding signature).
            MSG=$(git tag -l --format='%(contents:subject)%0a%(contents:body)' "$TAG_NAME")
            MSG_LENGTH=$(printf '%s' "$MSG" | wc -c)

            if [ "$MSG_LENGTH" -lt "$MIN_MSG_LENGTH" ]; then
                echo ""
                echo "pre-push: REJECTED — tag $TAG_NAME annotation too short"
                echo ""
                echo "  Annotation length: $MSG_LENGTH chars (min: $MIN_MSG_LENGTH)"
                echo "  Release notes would be insufficient. Write a real annotation."
                echo ""
                echo "  Current annotation:"
                echo "  ---"
                printf '%s' "$MSG" | sed 's/^/    /'
                echo ""
                echo "  ---"
                echo ""
                REJECTED=1
                continue
            fi
            ;;

        refs/heads/root)
            [ "$CANONICAL" -eq 0 ] && continue

            # Branch deletion is the ruleset's business, not this gate's.
            case "$local_sha" in
                0000000000000000000000000000000000000000) continue ;;
            esac

            echo ""
            echo "pre-push: REJECTED — direct push to root on GottZ/ctx"
            echo ""
            echo "  root moves only by merging a pull request (GOVERNANCE.md)."
            echo "  Push your branch and open one:"
            echo ""
            echo "    git push -u origin <branch>"
            echo "    gh pr create --base root"
            echo ""
            echo "  Release tags are pushed on their own after the merge:"
            echo "    git push origin vX.Y.Z"
            echo ""
            REJECTED=1
            continue
            ;;
    esac
done < "$TMP_REFS"

if [ "$REJECTED" -eq 1 ]; then
    echo "pre-push: push blocked. The server-side rulesets enforce the same; --no-verify only skips this message."
    echo ""
    exit 1
fi

# Gate 3 (T02-7, narrowed with the pull request flow) — deadcode allowlist
# tripwire on release pushes only. Pull request branches get the CI verdict
# (ci.yml runs deadcode.sh); a tag is cut on an already-judged merge commit,
# so this is the last local look before the Release workflow publishes
# binaries. Missing tool means a hint, never a block. T02-13 added the
# second mode (go/deadcode-testonly-allow.txt, class T); both run here in
# this order because the testonly run subtracts the with-tests allowlist.
if [ "$PUSHES_TAG" -eq 1 ]; then
    if command -v deadcode >/dev/null 2>&1; then
        if ! bash "$(git rev-parse --show-toplevel)/deadcode.sh"; then
            echo ""
            echo "pre-push: deadcode gate failed — cut the symbol, or add a line"
            echo "  with a reason to go/deadcode-allow.txt. Bypass: git push --no-verify"
            echo ""
            exit 1
        fi
        if ! bash "$(git rev-parse --show-toplevel)/deadcode.sh" testonly; then
            echo ""
            echo "pre-push: deadcode test-only ratchet failed — cut the symbol, or"
            echo "  add a line with a reason to go/deadcode-testonly-allow.txt."
            echo "  Bypass: git push --no-verify"
            echo ""
            exit 1
        fi
    else
        echo "pre-push: deadcode not found, skipping both allowlist gates (CI enforces them)."
        echo "  install: GOTOOLCHAIN=\$(go -C go env GOVERSION) go install golang.org/x/tools/cmd/deadcode@v0.52.0"
        echo "  (GOTOOLCHAIN: deadcode must be built with the toolchain of go/go.mod, else every package fails with 'requires newer Go version')"
    fi
fi

exit 0

#!/bin/sh
# Pre-push hook — enforces two release-discipline rules:
#
#   1. Branch pushes (refs/heads/*) require an annotated v* tag pointing at
#      the pushed HEAD. Either the tag already exists on origin (no-op for
#      the tag, just the branch moves) or it is part of the same `git push`.
#      Without this, fix-commits land on origin without ever appearing in a
#      release — exactly the regression that produced commits past v1.0.2
#      with no v1.0.3 tag.
#
#   2. Pushed version tags (refs/tags/v*) must be annotated AND carry a
#      substantial body (>= 80 chars). GitHub Releases inline the tag
#      annotation; lightweight or terse tags become useless release notes.
#
# Bypass: `git push --no-verify` — use sparingly, and only when an emergency
# revert needs to land before tagging is feasible. Routine work tags first.

MIN_MSG_LENGTH=80
REJECTED=0

# First pass: collect all refs being pushed in this invocation. We need the
# tag set to know whether a branch push is paired with its tag.
TMP_REFS=$(mktemp)
trap 'rm -f "$TMP_REFS"' EXIT

while read local_ref local_sha remote_ref remote_sha; do
    printf '%s %s %s %s\n' "$local_ref" "$local_sha" "$remote_ref" "$remote_sha" >> "$TMP_REFS"
done

# Build a list of v* tag SHAs being pushed, so the branch check can credit
# them even if `git tag --points-at` doesn't see the tag yet on origin.
PUSHED_TAG_TARGETS=$(awk '
    $3 ~ /^refs\/tags\/v/ {
        # local_sha is either the tag object (annotated) or the commit it
        # points at (lightweight). Resolve to the underlying commit.
        cmd = "git rev-parse " $2 "^{commit} 2>/dev/null"
        cmd | getline target
        close(cmd)
        if (target != "") print target
    }
' "$TMP_REFS")

while read local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/tags/v*)
            TAG_NAME=$(echo "$remote_ref" | sed 's|refs/tags/||')

            # Check object type: annotated tags are 'tag' objects, lightweight
            # are 'commit' objects (they point directly to a commit).
            OBJ_TYPE=$(git cat-file -t "$local_sha" 2>/dev/null)
            if [ "$OBJ_TYPE" != "tag" ]; then
                echo ""
                echo "pre-push: REJECTED — lightweight tag $TAG_NAME"
                echo ""
                echo "  Version tags must be annotated (carries release notes)."
                echo "  Lightweight tags produce fallback release bodies."
                echo ""
                echo "  Recreate:"
                echo "    git tag -d $TAG_NAME"
                echo '    git tag -a '"$TAG_NAME"' -m "\$(cat <<EOF'
                echo "$TAG_NAME — Kurzer Titel"
                echo ""
                echo "    Was ist neu (2-3 Saetze). Technische Details."
                echo "    EOF"
                echo "    )\""
                echo ""
                REJECTED=1
                continue
            fi

            # Check annotation length (subject + body, excluding signature).
            MSG=$(git tag -l --format='%(contents:subject)%0a%(contents:body)' "$TAG_NAME")
            MSG_LENGTH=$(printf '%s' "$MSG" | wc -c)

            if [ "$MSG_LENGTH" -lt "$MIN_MSG_LENGTH" ]; then
                echo ""
                echo "pre-push: REJECTED — tag $TAG_NAME annotation too short"
                echo ""
                echo "  Annotation length: $MSG_LENGTH chars (min: $MIN_MSG_LENGTH)"
                echo "  Release notes would be insufficient. Write a real annotation."
                echo ""
                echo "  Current annotation:"
                echo "  ---"
                printf '%s' "$MSG" | sed 's/^/    /'
                echo ""
                echo "  ---"
                echo ""
                REJECTED=1
                continue
            fi
            ;;

        refs/heads/*)
            BRANCH_NAME=$(echo "$remote_ref" | sed 's|refs/heads/||')

            # Skip branch-deletion pushes (local_sha is all-zeros).
            case "$local_sha" in
                0000000000000000000000000000000000000000) continue ;;
            esac

            # Resolve HEAD to a commit SHA for tag lookup.
            HEAD_COMMIT=$(git rev-parse "$local_sha^{commit}" 2>/dev/null)
            [ -z "$HEAD_COMMIT" ] && continue

            # Tag credit: any local v* tag pointing at HEAD, OR any v* tag
            # being pushed in the same invocation whose target equals HEAD.
            LOCAL_TAG=$(git tag --points-at "$HEAD_COMMIT" --list 'v*' 2>/dev/null | head -1)
            SAME_PUSH_TAG=$(printf '%s\n' "$PUSHED_TAG_TARGETS" | grep -Fx "$HEAD_COMMIT" | head -1)

            if [ -z "$LOCAL_TAG" ] && [ -z "$SAME_PUSH_TAG" ]; then
                SHORT=$(git rev-parse --short "$HEAD_COMMIT")
                LAST_TAG=$(git describe --tags --abbrev=0 "$HEAD_COMMIT" 2>/dev/null || echo "<none>")
                AHEAD=$(git rev-list --count "${LAST_TAG}..${HEAD_COMMIT}" 2>/dev/null || echo "?")
                echo ""
                echo "pre-push: REJECTED — branch $BRANCH_NAME HEAD ($SHORT) carries no v* tag"
                echo ""
                echo "  Last tag reachable: $LAST_TAG ($AHEAD commit(s) behind HEAD)"
                echo ""
                echo "  Every commit that lands on origin must be part of a release."
                echo "  Tag the HEAD before pushing, then push branch and tag together:"
                echo ""
                echo "    git tag -a vX.Y.Z -m \"\$(cat <<EOF"
                echo "    vX.Y.Z — Kurzer Titel"
                echo ""
                echo "    Was ist neu (2-3 Saetze, technische Details, mind. 80 Zeichen)."
                echo "    EOF"
                echo "    )\""
                echo "    git push origin $BRANCH_NAME vX.Y.Z"
                echo ""
                echo "  Bypass for emergency reverts only: git push --no-verify"
                echo ""
                REJECTED=1
                continue
            fi
            ;;
    esac
done < "$TMP_REFS"

if [ "$REJECTED" -eq 1 ]; then
    echo "pre-push: push blocked. Use --no-verify to bypass (use sparingly)."
    echo ""
    exit 1
fi

exit 0

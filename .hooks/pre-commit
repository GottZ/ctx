#!/bin/sh
# Pre-commit hook — runs two gates:
#
#   1. Sanity check on newly-added files: blocks accidental commits of
#      sensitive/private content into the public main-repo. Triggered by
#      a W47-NEU-B sub-agent (2026-05-27) that committed
#      .eval-cyclic-gold.json with private corpus block-IDs into the
#      public repo, requiring a full git-history rewrite to remove.
#      This hook makes that class of mistake hard to repeat.
#
#   2. golangci-lint on staged Go files (existing gate).
#
# Setup: git config core.hooksPath .hooks
# Bypass: git commit --no-verify — use sparingly.

set -u

# ============================================================
# Gate 1: Sensitive new-file pattern check
# ============================================================
#
# Patterns match newly-added (status A) files only. Modifications to
# already-tracked files are not re-checked — once a file is in, the
# decision was made.
#
# To allow a legitimate match, either:
#   - place the file under .project/ (private submodule)
#   - add an explicit !whitelist entry in .gitignore
#   - run `git commit --no-verify` (logged in commit metadata)

NEW_FILES=$(git diff --cached --name-only --diff-filter=A 2>/dev/null)

if [ -n "$NEW_FILES" ]; then
    BLOCKED=""
    while IFS= read -r f; do
        [ -z "$f" ] && continue
        base=$(basename "$f")

        # Tier-1 hard block: credentials, keys, env, dump files
        case "$base" in
            *.example|*.template)
                # Templates are safe by convention — skip all other checks
                continue
                ;;
        esac

        case "$base" in
            .env|.env.*)
                BLOCKED="$BLOCKED\n  $f  [env file — credentials risk]"
                ;;
            *secret*|*credentials*|*passwd*|*password*)
                BLOCKED="$BLOCKED\n  $f  [secret/credentials in filename]"
                ;;
            *.key|*.pem|*.p12|*.pfx|id_rsa|id_ed25519)
                BLOCKED="$BLOCKED\n  $f  [private key file]"
                ;;
            backup-*.sql|backup-*.dump|*-pre-v*.sql|*-pre-v*.dump)
                BLOCKED="$BLOCKED\n  $f  [DB dump — likely private corpus]"
                ;;
        esac

        # Tier-1 hard block: bench/eval gold/baseline files (corpus-specific)
        case "$base" in
            .eval-baseline.json|.eval-cyclic-baseline.json|.eval-cyclic-gold.json|eval-cyclic-gold*.json|eval-cyclic-results*.json|eval-baseline*.json)
                BLOCKED="$BLOCKED\n  $f  [bench gold/baseline — corpus-specific, belongs in .project submodule]"
                ;;
        esac

        # Tier-2 content heuristic: large new JSON in repo-root with corpus markers
        case "$f" in
            */*) ;;  # nested — skip (caller probably scoped correctly)
            *.json|*.jsonl)
                size=$(wc -c < "$f" 2>/dev/null || echo 0)
                if [ "$size" -gt 20000 ]; then
                    # Sample for corpus-specific markers
                    if grep -qE '"expected_top_k_block_ids"|"interaction_id"|"block_id":[[:space:]]*"019[a-f0-9]' "$f" 2>/dev/null; then
                        BLOCKED="$BLOCKED\n  $f  [large root-level JSON with corpus block-IDs — likely private bench data]"
                    fi
                fi
                ;;
        esac
    done <<EOF
$NEW_FILES
EOF

    if [ -n "$BLOCKED" ]; then
        printf '\n'
        printf 'pre-commit: REJECTED — new files match sensitive patterns:\n'
        printf '%b\n' "$BLOCKED"
        printf '\n'
        printf 'Resolutions in order of preference:\n'
        printf '  1. Move to .project/ submodule (private):\n'
        printf '       mv <file> .project/<file>\n'
        printf '       git rm --cached <file>\n'
        printf '       (cd .project && git add <file> && git commit && git push)\n'
        printf '       git commit --amend  # update submodule pointer\n'
        printf '\n'
        printf '  2. Whitelist a known-safe template (.example/.template suffix):\n'
        printf '       mv <file> <file>.example  # if it is actually a template\n'
        printf '\n'
        printf '  3. Emergency bypass (logged in commit metadata):\n'
        printf '       git commit --no-verify\n'
        printf '\n'
        printf 'Background: W47-NEU-B-Sub-Agent (2026-05-27) committed\n'
        printf '.eval-cyclic-gold.json with private corpus block-IDs into the public\n'
        printf 'repo, requiring a full git-history rewrite to remove. This gate\n'
        printf 'prevents that class of mistake.\n'
        exit 1
    fi
fi

# ============================================================
# Gate 2: .env secret-value leak check
# ============================================================
#
# Blocks committing any file whose staged content contains a *value* of a
# secret-named variable (PASSWORD/PASSWD/SECRET/TOKEN/_KEY/API_KEY/
# CREDENTIAL/_PW) from .env. External signal against re-leaking a rotated
# credential into the repo (the hardcoded-PGPASSWORD class of mistake).
# Values are never printed — only the env KEY name and the offending file.
# Override the env path via CTX_ENV_FILE; bypass with git commit --no-verify.

ENV_FILE="${CTX_ENV_FILE:-.env}"
if [ -f "$ENV_FILE" ]; then
    STAGED=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null)
    if [ -n "$STAGED" ]; then
        ENV_LEAKS=$(
            grep -E '^[[:space:]]*(export[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*=' "$ENV_FILE" | while IFS= read -r line; do
                key=${line#*export }
                key=${key%%=*}
                key=$(printf '%s' "$key" | tr -d '[:space:]')
                val=${line#*=}
                val=${val%\"}; val=${val#\"}
                val=${val%\'}; val=${val#\'}
                # No case-in-$() here: bash 3.2's command-substitution parser
                # is not recursive — the first unquoted ')' of a case arm inside
                # $( ... ) is read as the closing paren of the $( (issue #20).
                # grep -E mirrors the old globs exactly: all substrings, except
                # _KEY/_PW which were suffix globs and stay $-anchored.
                printf '%s\n' "$key" | grep -Eq 'PASSWORD|PASSWD|SECRET|TOKEN|API_?KEY|CREDENTIAL|(_KEY|_PW)$' || continue
                [ "${#val}" -ge 8 ] || continue
                printf '%s\n' "$STAGED" | while IFS= read -r f; do
                    [ -z "$f" ] && continue
                    if git show ":$f" 2>/dev/null | grep -qF -- "$val"; then
                        printf '  [$%s] leaked in %s\n' "$key" "$f"
                    fi
                done
            done
        )
        if [ -n "$ENV_LEAKS" ]; then
            printf '\n'
            printf 'pre-commit: REJECTED — staged content contains a secret VALUE from %s:\n' "$ENV_FILE"
            printf '%s\n' "$ENV_LEAKS"
            printf '\n'
            printf 'Do NOT hardcode credentials — read them from the environment, e.g.\n'
            printf '  PGPASSWORD="$CONTEXT_DB_PASSWORD" psql ...   (or source .env at runtime)\n'
            printf 'If the value is already rotated/dead, bypass with: git commit --no-verify\n'
            printf '\n'
            exit 1
        fi
    fi
fi

# ============================================================
# Gate 3: schema-contract manifest sync (W03-2, design/03 §4.9)
# ============================================================
#
# A staged migration without a staged manifest regeneration would ship a
# checked-in contract that no longer describes the migration chain it
# claims to — silently, until some unrelated later commit happens to
# regenerate it. Forces the two to land in the same commit.

STAGED_MIGRATIONS=$(git diff --cached --name-only --diff-filter=ACMR -- 'go/migrations/*.sql' 2>/dev/null)
if [ -n "$STAGED_MIGRATIONS" ]; then
    MANIFEST_STAGED=$(git diff --cached --name-only --diff-filter=ACMR -- 'go/internal/schemacontract/manifest.json' 2>/dev/null)
    if [ -z "$MANIFEST_STAGED" ]; then
        printf '\n'
        printf 'pre-commit: REJECTED — migration(s) staged without a manifest regeneration:\n'
        printf '%s\n' "$STAGED_MIGRATIONS" | sed 's/^/  /'
        printf '\n'
        printf 'Regenerate and stage the contract manifest:\n'
        printf '  cd go && go test -tags=genmanifest ./internal/schemacontract -run TestGenerateManifest\n'
        printf '  git add go/internal/schemacontract/manifest.json\n'
        printf '\n'
        printf 'Emergency bypass (logged in commit metadata): git commit --no-verify\n'
        printf '\n'
        exit 1
    fi
fi

# ============================================================
# Gate 4: golangci-lint + integration-tag vet on staged Go files
# ============================================================
#
# go vet -tags=integration is the local mirror of the CI matrix leg that
# broke v3.5.0: `go test -short` and golangci NEVER compile build-tagged
# _test.go files, so a signature drift in an integration test ships
# invisibly and only CI goes red (lesson 019ebdb4-65e0, G27→v3.5.1).

STAGED_GO=$(git diff --cached --name-only --diff-filter=ACM -- '*.go')
if [ -z "$STAGED_GO" ]; then
    exit 0
fi

cd go || exit 0

echo "pre-commit: running go vet -tags=integration..."
go vet -tags=integration ./...
RESULT=$?
if [ $RESULT -ne 0 ]; then
    echo ""
    echo "pre-commit: integration-tagged files do not compile. Fix or commit with --no-verify."
    exit $RESULT
fi

echo "pre-commit: running golangci-lint..."
if ! command -v golangci-lint >/dev/null 2>&1; then
    echo "pre-commit: golangci-lint not found, skipping lint"
    exit 0
fi

golangci-lint run --timeout=2m
RESULT=$?

if [ $RESULT -ne 0 ]; then
    echo ""
    echo "pre-commit: lint failed. Fix issues or commit with --no-verify to skip."
fi

exit $RESULT

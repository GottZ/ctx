# Ignore all dotfiles/dotdirs (.env, .n8n/, .claude/, .project/, .eval-baseline.json, ...)
.*
!.gitignore
!.gitmodules
!.env.example
!.project

# Local overrides
docker-compose.override.yml

# Data & backups
db/
backups/
backup-*.sql

# Build artifacts
go/ctx
go/dist/

# Frontend (Svelte 5 + Vite, bun)
go/web/node_modules/
go/web/dist/*
!go/web/dist/.gitkeep
!.gitkeep
!go/.dockerignore

# Misc
*.swp
*.swo
*~
Thumbs.db

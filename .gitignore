# Ignore all dotfiles/dotdirs (.env, .n8n/, .claude/, .project/, .eval-baseline.json, ...)
.*
!.gitignore
!.gitmodules
!.env.example
!.project
# CI workflow assets (workflows/ were force-added before this exception;
# scripts/ + budget json arrived with wave PV8):
!.github

# Local overrides
docker-compose.override.yml

# Site-local backup hooks (sourced by backup.sh; here a symlink into the private .project submodule)
backup.d

# Data & backups
db/
backups/
backup-*.sql

# Build artifacts
go/ctx
go/dist/

# Frontend (Svelte 5 + Vite, bun)
go/web/node_modules/
